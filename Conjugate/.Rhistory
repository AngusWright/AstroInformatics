'cool', rgb_array)
N = 25
delta=0.1
scale=0.68
sig8 = np.linspace(0.8-delta,0.8+delta,num=N)
dz = np.linspace(-delta*scale,delta*scale,num=N)
theta = np.geomspace(.5,300,100)/60 #in degrees
z = np.linspace(0.01, 1.5, 1000)
nz = np.zeros_like(z)
nz[np.where(np.abs(z -.5) < 0.01)[0]] = 1.0
b1 = np.ones_like(z)
A_IA = 0.*np.ones_like(z)
ell = np.unique((np.geomspace(2, 1e5)).astype(int))
tracers_fid = {}
cosmo_fid = ccl.Cosmology(Omega_c=0.25, Omega_b=0.05, h=0.7, sigma8=0.8, n_s=0.965)
tracers_fid['s'] = ccl.WeakLensingTracer(cosmo_fid, dndz=(z, nz), ia_bias=(z, A_IA))
cls1_fid = ccl.angular_cl(cosmo_fid, tracers['s'], tracers['s'], ell, l_limber = 1,limber_max_error=0.0001)
xi_fid_plus  = ccl.correlation(cosmo_fid, ell=ell, C_ell=cls1_fid, theta=theta, type='GG+', method='FFTLog')
xi_fid_minus = ccl.correlation(cosmo_fid, ell=ell, C_ell=cls1_fid, theta=theta, type='GG-', method='FFTLog')
for i in range(N):
sig8_tmp = sig8[i]
tracers = {}
tracers_dz = {}
tracers_both = {}
nz_dz = np.zeros_like(z)
nz_dz[np.where(np.abs(z -.5+dz[i]) < 0.01)[0]] = 1.0
cosmo = ccl.Cosmology(Omega_c=0.25, Omega_b=0.05, h=0.7, sigma8=sig8_tmp, n_s=0.965)
tracers['s'] = ccl.WeakLensingTracer(cosmo, dndz=(z, nz), ia_bias=(z, A_IA))
tracers_dz['s'] = ccl.WeakLensingTracer(cosmo_fid, dndz=(z, nz_dz), ia_bias=(z, A_IA))
tracers_both['s'] = ccl.WeakLensingTracer(cosmo, dndz=(z, nz_dz), ia_bias=(z, A_IA))
cls1 = ccl.angular_cl(cosmo, tracers['s'], tracers['s'], ell, l_limber = 1,limber_max_error=0.0001)
cls1_both = ccl.angular_cl(cosmo, tracers_both['s'], tracers_both['s'], ell, l_limber = 1,limber_max_error=0.0001)
cls1_dz = ccl.angular_cl(cosmo_fid, tracers_dz['s'], tracers_dz['s'], ell, l_limber = 1,limber_max_error=0.0001)
if i == 0:
xi_both_plus  = ccl.correlation(cosmo, ell=ell, C_ell=cls1_both, theta=theta, type='GG+', method='FFTLog')
xi_both_minus = ccl.correlation(cosmo, ell=ell, C_ell=cls1_both, theta=theta, type='GG-', method='FFTLog')
xi_dz_plus  = ccl.correlation(cosmo_fid, ell=ell, C_ell=cls1_dz, theta=theta, type='GG+', method='FFTLog')
xi_dz_minus = ccl.correlation(cosmo_fid, ell=ell, C_ell=cls1_dz, theta=theta, type='GG-', method='FFTLog')
xi_plus  = ccl.correlation(cosmo, ell=ell, C_ell=cls1, theta=theta, type='GG+', method='FFTLog')
xi_minus = ccl.correlation(cosmo, ell=ell, C_ell=cls1, theta=theta, type='GG-', method='FFTLog')
else:
xi_both_plus  = np.c_[xi_both_plus, ccl.correlation(cosmo, ell=ell, C_ell=cls1_both, theta=theta, type='GG+', method='FFTLog')]
xi_both_minus = np.c_[xi_both_minus,ccl.correlation(cosmo, ell=ell, C_ell=cls1_both, theta=theta, type='GG-', method='FFTLog')]
