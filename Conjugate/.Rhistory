table(factor(x,levels=seq(0,1,len=11)))
#What about 1 million discrete values?
any(table(factor(x,levels=seq(0,1,len=1e6)))!=0)
#1 million samples of a continuous variable x = [0,1]
x=runif(1e6)
#Check the PMF for 10 discrete values in [0,1]
table(factor(x,levels=seq(0,1,len=11)))
