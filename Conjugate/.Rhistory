xi_plus  = np.c_[xi_plus, ccl.correlation(cosmo, ell=ell, C_ell=cls1, theta=theta, type='GG+', method='FFTLog')]
xi_minus = np.c_[xi_minus,ccl.correlation(cosmo, ell=ell, C_ell=cls1, theta=theta, type='GG-', method='FFTLog')]
