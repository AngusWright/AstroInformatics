bins<-seq(0,1,len=n)
points((bins[1:(length(bins)-1)]+bins[2:(length(bins))])/2,
table(cut(x,breaks=bins))/1e6/diff(bins[1:2]),pch=n,col=n)
}
legend('top',title='Number of Intervals',legend=seq(5,20,len=4),pch=1:5,col=1:5)
